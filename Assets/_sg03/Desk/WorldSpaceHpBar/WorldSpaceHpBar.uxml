<ui:UXML xmlns:ui="UnityEngine.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="WorldSpaceHpBar.uss" />
    <ui:VisualElement class="health-bar-root">
        <ui:VisualElement class="health-bar-track"><ui:VisualElement name="HealthFill" class="health-bar-fill" /></ui:VisualElement>
        <ui:Label name="HealthLabel" text="65 / 100" class="health-bar-label" />
    </ui:VisualElement>
</ui:UXML>
