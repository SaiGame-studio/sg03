.attack-root { width: 640px; height: 100px; position: absolute; left: 50%; top: 50%; translate: -50% -50%; justify-content: center; align-items: center; }
.attack-stat-row { flex-direction: row; justify-content: center; align-items: center; }
.attack-label { color: rgb(255, 255, 255); font-size: 60px; -unity-font-style: bold; -unity-text-align: middle-center; -unity-text-outline-width: 6px; -unity-text-outline-color: rgb(0, 0, 0); }
.attack-sword-icon { width: 48px; height: 48px; margin-left: 8px; background-image: url("project://database/Assets/_sg03/UI/Images/hammer.svg"); -unity-background-scale-mode: scale-to-fit; }
