@import url("../Common/Variables.uss");

/* ============================================================
   Quest panel root — fills ContentArea, row layout
   ============================================================ */
.quest-panel-root {
    flex: 1;
    flex-direction: row;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ============================================================
   Left sidebar navigation
   ============================================================ */
.quest-sidebar {
    width: 220px;
    min-width: 220px;
    background-color: rgba(12, 16, 28, 1);
    border-right-width: 1px;
    border-color: rgba(80, 100, 160, 0.2);
    flex-direction: column;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 0;
    padding-right: 0;
}

/* ---- Section header ---- */
.quest-sidebar__header {
    flex-direction: row;
    align-items: center;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 20px;
    padding-right: 16px;
    margin-bottom: 8px;
}

.quest-sidebar__header-icon {
    font-size: 16px;
    color: rgb(110, 160, 255);
    margin-right: 10px;
    -unity-text-align: middle-center;
    width: 20px;
}

.quest-sidebar__header-label {
    font-size: 14px;
    color: rgb(180, 195, 240);
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-left;
}

/* ---- Thin separator under the header ---- */
.quest-sidebar__divider {
    height: 1px;
    background-color: rgba(80, 100, 160, 0.2);
    margin-top: 4px;
    margin-bottom: 8px;
    margin-left: 16px;
    margin-right: 16px;
}

/* ---- Nav items ---- */
.quest-nav-btn {
    flex-direction: row;
    align-items: center;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 20px;
    padding-right: 16px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;
    border-left-width: 3px;
    border-left-color: transparent;
    border-radius: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    margin-bottom: 2px;
    transition-duration: 0.1s;
}

.quest-nav-btn:hover {
    background-color: rgba(80, 100, 160, 0.18);
    color: rgb(210, 220, 255);
    border-left-color: rgba(80, 100, 160, 0.5);
}

.quest-nav-btn:hover .quest-nav-btn__icon,
.quest-nav-btn:hover .quest-nav-btn__label {
    color: rgb(210, 220, 255);
}

/* Active: accent left border + tinted background */
.quest-nav-btn--active {
    background-color: rgba(60, 110, 230, 0.18);
    color: rgb(130, 175, 255);
    -unity-font-style: bold;
    border-left-color: rgb(90, 150, 255);
}

.quest-nav-btn--active .quest-nav-btn__icon,
.quest-nav-btn--active .quest-nav-btn__label {
    color: rgb(130, 175, 255);
    -unity-font-style: bold;
}

.quest-nav-btn__icon {
    font-size: 15px;
    -unity-text-align: middle-center;
    width: 22px;
    margin-right: 10px;
    color: rgb(150, 160, 200);
}

.quest-nav-btn__label {
    -unity-text-align: middle-left;
    color: rgb(150, 160, 200);
    font-size: 13px;
    flex: 1;
}

/* ============================================================
   Main content area
   ============================================================ */
.quest-content-area {
    flex: 1;
    align-items: stretch;
    justify-content: flex-start;
    padding: 24px;
}

/* ============================================================
   Coming-Soon card (shared by DailyQuest & MainQuest content)
   ============================================================ */
.quest-coming-soon {
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 26, 40, 1);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 48px 56px;
}

.quest-coming-soon__icon {
    font-size: 48px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.quest-coming-soon__title {
    font-size: 22px;
    color: rgb(220, 228, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    letter-spacing: 1px;
}

.quest-coming-soon__badge {
    font-size: 13px;
    color: rgb(110, 160, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(60, 110, 230, 0.2);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(80, 130, 255, 0.45);
    padding: 4px 18px;
    margin-bottom: 20px;
    letter-spacing: 2px;
}

.quest-coming-soon__desc {
    font-size: 13px;
    color: rgb(140, 155, 195);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 340px;
}

/* Main quest tree: depth is horizontal, branches are laid out vertically. */
.main-quest-root { position: relative; flex: 1; flex-direction: column; min-height: 0; background-color: rgb(12, 16, 28); border-radius: 12px; border-width: 1px; border-color: rgba(80, 100, 160, 0.28); overflow: hidden; }
.main-quest-header { flex-direction: row; align-items: center; justify-content: space-between; padding: 18px 22px; border-bottom-width: 1px; border-color: rgba(80, 100, 160, 0.25); }
.main-quest-header__copy { flex-direction: column; }
.main-quest-header__title { color: rgb(220, 228, 255); font-size: 17px; -unity-font-style: bold; letter-spacing: 1px; }
.main-quest-header__subtitle { color: rgb(135, 155, 205); font-size: 12px; margin-top: 3px; }
.main-quest-refresh-button { width: 30px; height: 28px; color: rgb(155, 190, 255); background-color: rgba(60, 110, 230, 0.18); border-color: rgba(90, 150, 255, 0.55); border-radius: 5px; padding: 0; font-size: 16px; }
.main-quest-state { position: absolute; top: 84px; right: 22px; color: rgb(185, 200, 240); background-color: rgba(24, 32, 54, 0.94); border-width: 1px; border-color: rgba(90, 130, 220, 0.42); border-radius: 6px; padding: 6px 10px; font-size: 13px; }
.main-quest-scroll-view { flex: 1; min-height: 0; background-color: rgba(5, 8, 16, 0.62); }
.main-quest-canvas { position: relative; min-width: 100%; min-height: 100%; }
.main-quest-connector { position: absolute; background-color: rgba(112, 151, 225, 0.66); }
.main-quest-connector-arrow { position: absolute; width: 0; height: 0; border-top-width: 5px; border-bottom-width: 5px; border-left-width: 8px; border-top-color: transparent; border-bottom-color: transparent; border-left-color: rgb(133, 169, 240); }
.main-quest-card { position: absolute; width: 220px; height: 92px; padding: 13px 15px; background-color: rgb(20, 26, 43); border-width: 1px; border-color: rgba(112, 151, 225, 0.55); border-radius: 8px; }
.main-quest-card__title { color: rgb(230, 235, 255); font-size: 14px; -unity-font-style: bold; white-space: normal; }
.main-quest-card__id { color: rgb(120, 138, 180); font-size: 10px; margin-top: 5px; }
.main-quest-card__status { align-self: flex-start; color: rgb(180, 195, 235); background-color: rgba(95, 120, 185, 0.24); border-radius: 9px; font-size: 10px; -unity-font-style: bold; padding: 3px 8px; margin-top: 7px; }
.main-quest-card--completed { border-color: rgba(70, 215, 140, 0.9); }
.main-quest-card--completed .main-quest-card__status { color: rgb(105, 235, 165); background-color: rgba(30, 160, 95, 0.24); }
.main-quest-card--active { border-color: rgba(90, 160, 255, 1); }
.main-quest-card--active .main-quest-card__status { color: rgb(135, 190, 255); background-color: rgba(50, 115, 230, 0.3); }
.main-quest-card--locked { border-color: rgba(105, 112, 138, 0.7); opacity: 0.68; }
.main-quest-card--locked .main-quest-card__status { color: rgb(150, 155, 170); background-color: rgba(85, 90, 105, 0.35); }

/* Reusable React-Flow-style graph component. */
.main-quest-graph-host { flex: 1; min-height: 0; position: relative; }
.quest-flow-viewport { flex: 1; position: relative; overflow: hidden; background-color: rgba(5, 8, 16, 0.62); }
.quest-flow-canvas { position: absolute; transform-origin: 0 0; }
.quest-flow-edge-layer, .quest-flow-node-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.quest-flow-edge { position: absolute; background-color: rgba(112, 151, 225, 0.66); }
.quest-flow-edge__arrow { position: absolute; width: 0; height: 0; border-top-width: 5px; border-bottom-width: 5px; border-left-width: 8px; border-top-color: transparent; border-bottom-color: transparent; border-left-color: rgb(133, 169, 240); }
.quest-flow-node { position: absolute; flex-direction: column; align-items: flex-start; padding: 13px 15px; background-color: rgb(20, 26, 43); border-width: 1px; border-color: rgba(112, 151, 225, 0.55); border-radius: 8px; }
.quest-flow-node:hover { background-color: rgb(27, 36, 58); border-color: rgb(130, 180, 255); }
.quest-flow-node__title { color: rgb(230, 235, 255); font-size: 14px; -unity-font-style: bold; white-space: normal; }
.quest-flow-node__subtitle { color: rgb(120, 138, 180); font-size: 10px; margin-top: 5px; }
.quest-flow-node__status { align-self: flex-start; color: rgb(180, 195, 235); background-color: rgba(95, 120, 185, 0.24); border-radius: 9px; font-size: 10px; -unity-font-style: bold; padding: 3px 8px; margin-top: 7px; }
.quest-flow-node--completed { border-color: rgba(70, 215, 140, 0.9); }
.quest-flow-node--completed .quest-flow-node__status { color: rgb(105, 235, 165); background-color: rgba(30, 160, 95, 0.24); }
.quest-flow-node--active { border-color: rgba(90, 160, 255, 1); }
.quest-flow-node--active .quest-flow-node__status { color: rgb(135, 190, 255); background-color: rgba(50, 115, 230, 0.3); }
.quest-flow-node--locked { border-color: rgba(105, 112, 138, 0.7); opacity: 0.68; }
.quest-flow-node--locked .quest-flow-node__status { color: rgb(150, 155, 170); background-color: rgba(85, 90, 105, 0.35); }
.quest-flow-controls { position: absolute; right: 14px; bottom: 14px; flex-direction: row; background-color: rgb(20, 26, 43); border-width: 1px; border-color: rgba(112, 151, 225, 0.5); border-radius: 6px; overflow: hidden; }
.quest-flow-controls__button { min-width: 32px; height: 30px; padding: 2px 8px; color: rgb(190, 210, 255); background-color: transparent; border-width: 0; border-right-width: 1px; border-color: rgba(112, 151, 225, 0.35); border-radius: 0; font-size: 12px; }
.quest-flow-controls__button:last-child { border-right-width: 0; }

/* Battle Pass chain graph. */
.battle-pass-root { position: relative; flex: 1; flex-direction: column; min-height: 0; overflow: hidden; }
.battle-pass-header { position: relative; flex-direction: row; align-items: center; padding-bottom: 16px; border-bottom-width: 1px; border-color: rgba(80, 100, 160, 0.2); margin-bottom: 20px; }
.battle-pass-header__title { font-size: 18px; color: rgb(200, 215, 255); -unity-font-style: bold; letter-spacing: 0.5px; }
.battle-pass-header__server-time { position: absolute; top: 0; right: 0; width: 150px; min-width: 150px; max-width: 150px; height: 22px; color: rgb(160, 180, 225); font-size: 13px; }
.battle-pass-toolbar { flex-direction: row; align-items: center; padding-bottom: 14px; margin-bottom: 12px; border-bottom-width: 1px; border-color: rgba(80, 100, 160, 0.2); }
.battle-pass-dropdown { min-width: 180px; margin-left: auto; margin-right: 10px; color: rgb(155, 170, 215); font-size: 12px; }
.battle-pass-dropdown .unity-base-field__input { color: rgb(155, 170, 215); background-color: rgba(30, 36, 58, 0.75); border-color: rgba(80, 100, 160, 0.35); border-width: 1px; border-radius: 7px; }
.battle-pass-session-schedule { flex-direction: row; align-items: center; flex-wrap: wrap; }
.battle-pass-session-schedule__title { color: rgb(190, 210, 255); font-size: 12px; -unity-font-style: bold; margin-right: 16px; }
.battle-pass-session-schedule__item { color: rgb(155, 180, 230); font-size: 10px; margin-right: 14px; }
.battle-pass-graph-host { flex: 1; min-height: 0; position: relative; border-radius: 8px; overflow: hidden; }
.battle-pass-state { position: absolute; top: 108px; right: 0; color: rgb(185, 200, 240); background-color: rgba(24, 32, 54, 0.94); border-width: 1px; border-color: rgba(90, 130, 220, 0.42); border-radius: 6px; padding: 6px 10px; font-size: 13px; }

/* Main Quest detail drawer, matching the Daily Quest detail-panel interaction. */
.main-quest-detail-panel { position: absolute; top: 0; right: 0; width: 380px; height: 100%; flex-direction: column; padding: 20px; background-color: rgb(18, 24, 40); border-left-width: 1px; border-color: rgba(80, 120, 210, 0.6); transition-property: right; transition-duration: 0.2s; transition-timing-function: ease-out; }
.main-quest-detail-panel--hidden { right: -412px; }
.main-quest-detail-panel--open { right: 0; }
.main-quest-detail-panel__header { flex-direction: row; align-items: center; padding-bottom: 12px; border-bottom-width: 1px; border-color: rgba(80, 100, 160, 0.35); }
.main-quest-detail-panel__title { flex: 1; color: rgb(220, 235, 255); font-size: 17px; -unity-font-style: bold; }
.main-quest-detail-panel__close { width: 28px; height: 28px; padding: 0; border-radius: 5px; color: rgb(170, 190, 235); background-color: rgba(80, 100, 160, 0.18); font-size: 20px; }
.main-quest-detail-panel__scroll { flex: 1; min-height: 0; }
.main-quest-detail-panel__content { flex-direction: column; padding-top: 16px; padding-right: 4px; }
.main-quest-detail__quest-title { color: rgb(230, 238, 255); font-size: 19px; -unity-font-style: bold; white-space: normal; margin-bottom: 18px; }
.main-quest-detail__row { flex-direction: column; padding: 10px 12px; margin-bottom: 8px; border-radius: 6px; background-color: rgba(45, 58, 90, 0.42); border-width: 1px; border-color: rgba(90, 120, 190, 0.22); }
.main-quest-detail__label { color: rgb(130, 150, 195); font-size: 10px; -unity-font-style: bold; }
.main-quest-detail__value { color: rgb(215, 225, 255); font-size: 13px; margin-top: 3px; white-space: normal; }
.main-quest-detail__error { color: rgb(255, 150, 150); font-size: 13px; white-space: normal; }

/* Keep the Chain Quest drawer visually identical to Daily Quest's detail drawer. */
.main-quest-detail-panel { background-color: rgb(20, 26, 45); border-color: rgba(105, 165, 255, 0.6); padding: 16px; transition-duration: 0.25s; }
.main-quest-detail-panel__close { color: rgb(190, 205, 245); background-color: rgba(50, 65, 105, 0.7); border-color: rgba(105, 165, 255, 0.55); border-width: 1px; border-radius: 6px; }
.main-quest-detail-panel__scroll .unity-scroll-view__vertical-scroller { width: 9px; margin-left: 5px; background-color: transparent; border-radius: 2px; }
.main-quest-detail-panel__scroll .unity-scroller__low-button, .main-quest-detail-panel__scroll .unity-scroller__high-button { display: none; }
.main-quest-detail-panel__scroll .unity-scroller__slider, .main-quest-detail-panel__scroll .unity-base-slider__tracker { background-color: transparent; border-width: 0; }
.main-quest-detail-panel__scroll .unity-base-slider__dragger { width: 9px; min-width: 9px; max-width: 9px; min-height: 20px; align-self: center; background-color: rgba(130, 160, 220, 0.34); border-width: 0; border-radius: 2px; }
.main-quest-detail-panel__content { padding-top: 14px; }
.main-quest-detail-panel__actions { flex-direction: row; margin-top: 12px; padding-top: 12px; border-top-width: 1px; border-color: rgba(80, 100, 160, 0.35); }
.main-quest-detail-panel__action { flex: 1; height: 32px; margin-right: 6px; color: rgb(220, 235, 255); background-color: rgba(50, 90, 190, 0.8); border-color: rgba(105, 165, 255, 0.85); border-width: 1px; border-radius: 6px; font-size: 12px; -unity-font-style: bold; }
.main-quest-detail-panel__action--last { margin-right: 0; }
.main-quest-detail-panel__action:disabled { color: rgb(115, 130, 165); background-color: rgba(40, 48, 70, 0.8); border-color: rgba(80, 100, 160, 0.28); }
.main-quest-detail-panel__action--claim:enabled { color: rgb(35, 28, 10); background-color: rgb(255, 210, 60); border-color: rgba(220, 170, 20, 0.9); }
.main-quest-detail-panel__expired-message, .main-quest-detail-panel__claimed-message, .main-quest-detail-panel__unavailable-message { display: none; flex-grow: 1; padding: 8px 10px; border-width: 1px; border-radius: 6px; -unity-text-align: middle-center; -unity-font-style: bold; }
.main-quest-detail-panel__expired-message { color: rgb(255, 185, 185); background-color: rgba(150, 50, 50, 0.25); border-color: rgba(255, 120, 120, 0.5); }
.main-quest-detail-panel__claimed-message { color: rgb(175, 255, 195); background-color: rgba(50, 150, 80, 0.25); border-color: rgba(110, 230, 140, 0.5); }
.main-quest-detail-panel__unavailable-message { color: rgb(190, 215, 255); background-color: rgba(50, 90, 150, 0.25); border-color: rgba(110, 165, 255, 0.5); }
.main-quest-detail__name { color: rgb(225, 235, 255); font-size: 18px; -unity-font-style: bold; white-space: normal; margin-bottom: 10px; }
.main-quest-detail__description { color: rgb(170, 185, 220); font-size: 12px; white-space: normal; margin-bottom: 14px; }
.main-quest-detail__section { color: rgb(130, 180, 255); font-size: 12px; -unity-font-style: bold; margin-top: 10px; margin-bottom: 5px; }
.main-quest-detail__condition { flex-direction: column; background-color: rgba(35, 45, 75, 0.7); border-left-width: 3px; border-color: rgb(100, 160, 255); border-radius: 6px; padding: 8px 10px; margin-bottom: 6px; }
.main-quest-detail__condition-type { color: rgb(220, 235, 255); font-size: 12px; -unity-font-style: bold; margin-bottom: 4px; }
.main-quest-detail__condition-rule { color: rgb(165, 185, 225); font-size: 11px; white-space: normal; margin-top: 2px; }
.main-quest-detail__reward { flex-direction: column; background-color: rgba(42, 52, 82, 0.72); border-left-width: 3px; border-color: rgb(225, 178, 65); border-radius: 6px; padding: 8px 10px; margin-bottom: 6px; }
.main-quest-detail__reward-name { color: rgb(255, 225, 140); font-size: 12px; -unity-font-style: bold; white-space: normal; margin-bottom: 3px; }
.main-quest-detail__reward-info { color: rgb(175, 192, 230); font-size: 11px; white-space: normal; margin-top: 1px; }
.main-quest-detail__row { flex-direction: row; padding: 4px 0; border-bottom-width: 1px; border-color: rgba(80, 100, 160, 0.16); background-color: transparent; margin-bottom: 0; border-radius: 0; }
.main-quest-detail__key { width: 110px; color: rgb(125, 145, 190); font-size: 11px; }
.main-quest-detail__value { flex: 1; color: rgb(205, 215, 245); font-size: 11px; white-space: normal; margin-top: 0; }
