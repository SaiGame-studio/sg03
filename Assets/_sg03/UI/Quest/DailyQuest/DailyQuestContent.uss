/* ============================================================
   Daily Quest content — fills QuestContentArea
   ============================================================ */
.dq-content {
    flex: 1;
    flex-direction: column;
    width: 100%;
    align-self: stretch;
}

/* ---- Header ---- */
.dq-header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.2);
    margin-bottom: 20px;
}

.dq-header__title {
    font-size: 18px;
    color: rgb(200, 215, 255);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

/* ============================================================
   7-day week grid
   ============================================================ */
.dq-week-grid {
    flex-direction: row;
    flex: 1;
    align-items: stretch;
    min-height: 260px;
}

/* ---- Day card ---- */
.dq-day-card {
    flex: 1;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(18, 22, 36, 1);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.2);
    padding: 0;
    margin-left: 4px;
    margin-right: 4px;
    min-height: 260px;
}

.dq-day-card:first-child {
    margin-left: 0;
}

.dq-day-card:last-child {
    margin-right: 0;
}

/* Today: accent border + tinted background */
.dq-day-card--today {
    border-color: rgba(90, 150, 255, 0.7);
    background-color: rgba(25, 35, 60, 1);
}

/* ---- Day card header ---- */
.dq-day-card__header {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(30, 36, 58, 1);
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.2);
}

.dq-day-card--today .dq-day-card__header {
    background-color: rgba(50, 90, 200, 0.4);
    border-color: rgba(90, 150, 255, 0.35);
}

.dq-day-card__day-name {
    font-size: 15px;
    color: rgb(160, 175, 220);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dq-day-card--today .dq-day-card__day-name {
    color: rgb(130, 180, 255);
}

.dq-day-card__date {
    font-size: 11px;
    color: rgb(100, 115, 160);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

.dq-day-card--today .dq-day-card__date {
    color: rgb(110, 160, 255);
}

/* Today badge */
.dq-day-card__today-badge {
    font-size: 9px;
    color: rgb(90, 150, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(60, 110, 230, 0.25);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 140, 255, 0.4);
    padding: 1px 8px;
    margin-top: 4px;
}

/* ---- Quest items inside a day card ---- */
.dq-day-card__quests {
    flex: 1;
    flex-direction: column;
    padding: 8px 6px;
}

.dq-quest-item {
    flex: 1;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(30, 36, 58, 0.6);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.15);
    padding: 7px 8px;
    margin-bottom: 6px;
}

/* Spacer that pushes bottom content to the bottom of the quest card */
.dq-quest-item__spacer {
    flex: 1;
}

/* Bottom section: claim button + status label, aligned to bottom */
.dq-quest-item__bottom {
    flex-direction: column;
    align-items: stretch;
    margin-top: 4px;
}

.dq-quest-item__claim-btn {
    font-size: 10px;
    color: rgb(20, 20, 30);
    background-color: rgb(255, 210, 60);
    border-color: rgba(220, 170, 20, 0.9);
    border-width: 1px;
    border-radius: 6px;
    padding: 3px 8px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    cursor: link;
}

.dq-quest-item__name {
    font-size: 11px;
    color: rgb(200, 215, 255);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 4px;
}

.dq-quest-item__status {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    border-radius: 6px;
    border-width: 1px;
    padding: 1px 7px;
    align-self: flex-start;
}

.dq-quest-item__status--not-started {
    color: rgb(130, 140, 175);
    background-color: rgba(60, 70, 100, 0.3);
    border-color: rgba(90, 100, 150, 0.35);
}

.dq-quest-item__status--in-progress {
    color: rgb(255, 210, 80);
    background-color: rgba(120, 85, 0, 0.3);
    border-color: rgba(200, 160, 30, 0.45);
}

.dq-quest-item__status--completed {
    color: rgb(80, 220, 130);
    background-color: rgba(0, 90, 40, 0.3);
    border-color: rgba(60, 180, 100, 0.45);
}

.dq-quest-item__status--claimed {
    color: rgb(110, 165, 255);
    background-color: rgba(30, 70, 180, 0.25);
    border-color: rgba(80, 140, 255, 0.4);
}

/* ---- Rewards row ---- */
.dq-quest-item__rewards {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
}

.dq-reward-chip {
    font-size: 9px;
    color: rgb(230, 200, 100);
    background-color: rgba(80, 60, 0, 0.35);
    border-color: rgba(180, 140, 30, 0.45);
    border-width: 1px;
    border-radius: 5px;
    padding: 1px 6px;
    margin-right: 4px;
    margin-bottom: 2px;
    -unity-font-style: bold;
}

/* No-quest placeholder */
.dq-day-card__no-quest {
    flex: 1;
    align-items: center;
    justify-content: center;
}

.dq-day-card__no-quest-icon {
    font-size: 18px;
    color: rgb(60, 75, 110);
    -unity-text-align: middle-center;
}

/* ============================================================
   Empty state
   ============================================================ */
.dq-empty {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    display: none;
}

.dq-empty__icon {
    font-size: 40px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
    color: rgb(100, 115, 160);
}

.dq-empty__label {
    font-size: 14px;
    color: rgb(120, 135, 175);
    -unity-text-align: middle-center;
}
