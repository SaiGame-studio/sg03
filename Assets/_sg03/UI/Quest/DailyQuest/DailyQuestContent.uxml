<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="DailyQuestContent.uss" />

    <ui:VisualElement class="dq-content">
        <ui:VisualElement class="dq-header">
            <ui:Label text="Daily Quest" class="dq-header__title" />
            <ui:VisualElement name="ServerTimeLabel" class="dq-header__server-time" />
        </ui:VisualElement>

        <ui:VisualElement name="DailyQuestToolbar" class="dq-range-tabs">
            <ui:Button name="ThisWeekTab" text="This Week" class="dq-range-tab" />
            <ui:Button name="ThisMonthTab" text="This Month" class="dq-range-tab" />
            <ui:Button name="Next7DaysTab" text="Next 7 Days" class="dq-range-tab dq-range-tab--active" />
            <ui:Button name="Next30DaysTab" text="Next 30 Days" class="dq-range-tab" />
            <ui:Button name="AssignAheadButton" text="Assign Ahead" tooltip="Assign quests for the selected range" class="dq-assign-ahead-button" />
            <ui:DropdownField name="PoolDropdown" class="dq-pool-dropdown" />
        </ui:VisualElement>

        <ui:VisualElement name="DailyQuestTabContent" class="dq-tab-content" />

        <ui:VisualElement name="MainQuestDetailPanel" class="main-quest-detail-panel main-quest-detail-panel--hidden">
            <ui:VisualElement class="dq-quest-detail-panel__header">
                <ui:Label text="Quest Details" class="dq-quest-detail-panel__title" />
                <ui:Button name="CloseQuestDetailButton" text="×" tooltip="Close" class="dq-quest-detail-panel__close" />
            </ui:VisualElement>
            <ui:ScrollView class="dq-quest-detail-panel__scroll">
                <ui:VisualElement name="MainQuestDetailContent" class="main-quest-detail-panel__content" />
            </ui:ScrollView>
            <ui:VisualElement name="QuestDetailActions" class="dq-quest-detail-panel__actions">
                <ui:Button name="MainQuestDetailStartButton" text="Start" class="main-quest-detail-panel__action" />
                <ui:Button name="MainQuestDetailCheckButton" text="Check" class="main-quest-detail-panel__action" />
                <ui:Button name="MainQuestDetailClaimButton" text="Claim" class="main-quest-detail-panel__action main-quest-detail-panel__action--claim main-quest-detail-panel__action--last" />
                <ui:Label name="MainQuestDetailExpiredMessage" text="This quest has expired." class="main-quest-detail-panel__expired-message" />
                <ui:Label name="MainQuestDetailClaimedMessage" text="Quest claimed successfully." class="main-quest-detail-panel__claimed-message" />
                <ui:Label name="MainQuestDetailUnavailableMessage" text="This quest is not available yet." class="main-quest-detail-panel__unavailable-message" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
