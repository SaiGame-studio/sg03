<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="DailyQuestContent.uss" />

    <ui:VisualElement class="dq-content">
        <ui:VisualElement class="dq-header">
            <ui:Label text="Daily Quest" class="dq-header__title" />
            <ui:VisualElement name="ServerTimeLabel" class="dq-header__server-time" />
        </ui:VisualElement>

        <ui:VisualElement name="DailyQuestToolbar" class="dq-range-tabs">
            <ui:Button name="ThisWeekTab" text="This Week" class="dq-range-tab" />
            <ui:Button name="ThisMonthTab" text="This Month" class="dq-range-tab" />
            <ui:Button name="Next7DaysTab" text="Next 7 Days" class="dq-range-tab dq-range-tab--active" />
            <ui:Button name="Next30DaysTab" text="Next 30 Days" class="dq-range-tab" />
            <ui:Button name="AssignAheadButton" text="Assign Ahead" tooltip="Assign quests for the selected range" class="dq-assign-ahead-button" />
            <ui:DropdownField name="PoolDropdown" class="dq-pool-dropdown" />
            <ui:Button name="RefreshButton" tooltip="Refresh" class="refresh-button">
                <ui:VisualElement class="refresh-button-component__icon" style="background-image: url(../../Images/refresh-128.png);" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement name="DailyQuestTabContent" class="dq-tab-content" />

        <ui:VisualElement name="QuestDetailPanel" class="dq-quest-detail-panel dq-quest-detail-panel--hidden">
            <ui:VisualElement class="dq-quest-detail-panel__header">
                <ui:Label text="Quest Details" class="dq-quest-detail-panel__title" />
                <ui:Button name="CloseQuestDetailButton" text="×" tooltip="Close" class="dq-quest-detail-panel__close" />
            </ui:VisualElement>
            <ui:ScrollView class="dq-quest-detail-panel__scroll">
                <ui:VisualElement name="QuestDetailContent" class="dq-quest-detail-panel__content" />
            </ui:ScrollView>
            <ui:VisualElement name="QuestDetailActions" class="dq-quest-detail-panel__actions">
                <ui:Button name="QuestDetailStartButton" text="Start" class="dq-quest-detail-panel__action" />
                <ui:Button name="QuestDetailCheckButton" text="Check" class="dq-quest-detail-panel__action" />
                <ui:Button name="QuestDetailClaimButton" text="Claim" class="dq-quest-detail-panel__action dq-quest-detail-panel__action--claim dq-quest-detail-panel__action--last" />
                <ui:Label name="QuestDetailExpiredMessage" text="This quest has expired." class="dq-quest-detail-panel__expired-message" />
                <ui:Label name="QuestDetailClaimedMessage" text="Quest claimed successfully." class="dq-quest-detail-panel__claimed-message" />
                <ui:Label name="QuestDetailUnavailableMessage" text="This quest is not available yet." class="dq-quest-detail-panel__unavailable-message" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
