<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="QuestPanel.uss" />

    <!-- Shared Quest panel layout: left sidebar + main content area -->
    <ui:VisualElement name="QuestPanelRoot" class="quest-panel-root">

        <!-- Left sidebar navigation -->
        <ui:VisualElement name="QuestSidebar" class="quest-sidebar">
            <ui:Label text="Quest" class="quest-sidebar__title" />
            <ui:Button name="DailyQuestNavBtn" text="Daily Quest" class="quest-nav-btn quest-nav-btn--active" />
            <ui:Button name="MainQuestNavBtn"  text="Main Quest"  class="quest-nav-btn" />
        </ui:VisualElement>

        <!-- Main content area — populated at runtime from DailyQuest/ or MainQuest/ -->
        <ui:VisualElement name="QuestContentArea" class="quest-content-area" />

    </ui:VisualElement>

</ui:UXML>
