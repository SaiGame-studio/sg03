<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <ui:VisualElement name="MainQuestRoot" class="main-quest-root">
        <ui:VisualElement class="main-quest-header">
            <ui:VisualElement class="main-quest-header__copy">
                <ui:Label text="MAIN QUEST" class="main-quest-header__title" />
                <ui:Label name="MainQuestChainName" text="Loading quest chain..." class="main-quest-header__subtitle" />
            </ui:VisualElement>
            <ui:Button name="MainQuestRefreshButton" text="Refresh" class="main-quest-refresh-button" />
        </ui:VisualElement>
        <ui:Label name="MainQuestState" class="main-quest-state" />
        <ui:VisualElement name="MainQuestGraphHost" class="main-quest-graph-host" />
    </ui:VisualElement>

</ui:UXML>
