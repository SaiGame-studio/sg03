<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="MailboxContent.uss" />

    <!-- Mailbox content — header + scrollable message list -->
    <ui:VisualElement name="MailboxRoot" class="mb-root">

        <!-- Header bar -->
        <ui:VisualElement class="mb-header">
            <ui:Label text="📬 Mailbox" class="mb-header__title" />
            <ui:Button name="RefreshBtn" text="↻ Refresh" class="mb-header__refresh-btn" />
        </ui:VisualElement>

        <!-- Loading state -->
        <ui:VisualElement name="LoadingState" class="mb-state">
            <ui:Label text="⏳" class="mb-state__icon" />
            <ui:Label text="Loading messages…" class="mb-state__label" />
        </ui:VisualElement>

        <!-- Empty state (no messages) -->
        <ui:VisualElement name="EmptyState" class="mb-state">
            <ui:Label text="📭" class="mb-state__icon" />
            <ui:Label text="No messages" class="mb-state__label" />
        </ui:VisualElement>

        <!-- Scrollable message list (populated at runtime) -->
        <ui:ScrollView name="MailList" class="mb-list" />

    </ui:VisualElement>

</ui:UXML>
