@import url("../Common/Variables.uss");

/* ============================================================
   Mailbox content root — fills ContentArea
   ============================================================ */
.mb-root {
    flex: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 12, 20, 0.97);
}

/* ============================================================
   Header bar
   ============================================================ */
.mb-header {
    flex-direction: row;
    align-items: center;
    height: 52px;
    min-height: 52px;
    padding: 0 24px;
    background-color: rgba(16, 20, 36, 1);
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
}

.mb-header__title {
    flex: 1;
    font-size: 15px;
    color: rgb(200, 210, 255);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.mb-header__refresh-btn {
    padding: 6px 14px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.4);
    background-color: rgba(40, 50, 80, 0.6);
    color: rgb(150, 160, 200);
    font-size: 12px;
    transition-duration: 0.1s;
}

.mb-header__refresh-btn:hover {
    background-color: rgba(60, 80, 130, 0.7);
    color: rgb(200, 215, 255);
}

/* ============================================================
   State views — loading and empty
   ============================================================ */
.mb-state {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.mb-state__icon {
    font-size: 40px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.mb-state__label {
    font-size: 14px;
    color: rgb(130, 145, 185);
    -unity-text-align: middle-center;
}

/* ============================================================
   Scrollable message list
   ============================================================ */
.mb-list {
    flex: 1;
    padding: 16px;
}

/* ============================================================
   Message row
   ============================================================ */
.mb-msg-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(22, 26, 40, 1);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.25);
    padding: 14px 16px;
    margin-bottom: 10px;
}

.mb-msg-row--unread {
    border-color: rgba(80, 120, 240, 0.55);
    background-color: rgba(28, 35, 60, 1);
}

/* Unread indicator dot */
.mb-msg-row__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(100, 155, 255);
    margin-right: 12px;
    flex-shrink: 0;
}

/* Text content area */
.mb-msg-row__content {
    flex: 1;
    flex-direction: column;
}

.mb-msg-row__subject {
    font-size: 13px;
    color: rgb(210, 220, 255);
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mb-msg-row--unread .mb-msg-row__subject {
    color: rgb(230, 240, 255);
}

.mb-msg-row__body {
    font-size: 12px;
    color: rgb(130, 145, 185);
    margin-bottom: 6px;
    white-space: normal;
}

.mb-msg-row__date {
    font-size: 11px;
    color: rgb(100, 115, 155);
}

/* Attachment chips */
.mb-attachments {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.mb-attachment-chip {
    flex-direction: column;
    background-color: rgba(30, 50, 35, 0.5);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 160, 80, 0.3);
    padding: 4px 8px;
    margin-right: 6px;
    margin-bottom: 4px;
}

/* Rarity-tinted borders */
.mb-attachment-chip--common     { border-color: rgba(160, 160, 160, 0.5); background-color: rgba(40, 40, 40, 0.45); }
.mb-attachment-chip--uncommon   { border-color: rgba(80, 200, 80, 0.5);  background-color: rgba(20, 60, 20, 0.45); }
.mb-attachment-chip--rare       { border-color: rgba(60, 140, 255, 0.55); background-color: rgba(15, 35, 75, 0.5); }
.mb-attachment-chip--epic       { border-color: rgba(180, 80, 255, 0.55); background-color: rgba(40, 15, 70, 0.5); }
.mb-attachment-chip--legendary  { border-color: rgba(255, 180, 30, 0.65); background-color: rgba(60, 40, 5, 0.5); }

.mb-attachment-chip__name {
    font-size: 11px;
    color: rgb(210, 230, 200);
    -unity-font-style: bold;
}

.mb-attachment-chip__meta {
    flex-direction: row;
    margin-top: 3px;
}

.mb-attachment-chip__rarity {
    font-size: 9px;
    -unity-font-style: bold;
    border-radius: 3px;
    border-width: 1px;
    padding: 0px 5px;
    margin-right: 4px;
    color: rgb(200, 200, 200);
    border-color: rgba(150, 150, 150, 0.4);
    background-color: rgba(60, 60, 60, 0.4);
}

.mb-attachment-chip__rarity--common    { color: rgb(180, 180, 180); border-color: rgba(160, 160, 160, 0.5); }
.mb-attachment-chip__rarity--uncommon  { color: rgb(100, 220, 100); border-color: rgba(80, 200, 80, 0.5); }
.mb-attachment-chip__rarity--rare      { color: rgb(100, 160, 255); border-color: rgba(60, 140, 255, 0.55); }
.mb-attachment-chip__rarity--epic      { color: rgb(200, 100, 255); border-color: rgba(180, 80, 255, 0.55); }
.mb-attachment-chip__rarity--legendary { color: rgb(255, 200, 50);  border-color: rgba(255, 180, 30, 0.65); }

.mb-attachment-chip__category {
    font-size: 9px;
    color: rgb(120, 135, 160);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(80, 100, 140, 0.35);
    padding: 0px 5px;
}

/* Right-side action area */
.mb-msg-row__right {
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    margin-left: 12px;
}

/* Claim button */
.mb-claim-btn {
    padding: 7px 16px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(60, 110, 230, 1);
    color: rgb(240, 244, 255);
    font-size: 12px;
    -unity-font-style: bold;
    transition-duration: 0.1s;
}

.mb-claim-btn:hover {
    background-color: rgba(80, 130, 255, 1);
}

/* Delete button */
.mb-delete-btn {
    padding: 6px 10px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(160, 40, 40, 0.55);
    color: rgb(255, 180, 180);
    font-size: 13px;
    margin-top: 6px;
    transition-duration: 0.1s;
}

.mb-delete-btn:hover {
    background-color: rgba(200, 50, 50, 0.85);
    color: rgb(255, 220, 220);
}

/* Status badges */
.mb-status-badge {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 6px;
    -unity-font-style: bold;
}

.mb-status-badge--claimed {
    background-color: rgba(40, 80, 40, 0.4);
    color: rgb(130, 210, 130);
    border-width: 1px;
    border-color: rgba(80, 160, 80, 0.4);
}
