<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="LoginPanel.uss" />

    <!-- Full-screen root -->
    <ui:VisualElement name="LoginRoot" class="panel-root">

        <!-- Card container -->
        <ui:VisualElement name="LoginCard" class="card">

            <!-- Title -->
            <ui:Label name="TitleLabel" text="Login" class="panel-title" />
            <ui:Label name="GameNameLabel" text="game-name" class="game-name" />

            <!-- Registration-only fields -->
            <ui:VisualElement name="RegisterFields">
                <ui:Label text="Email" class="field-label" />
                <ui:TextField name="RegisterEmailField"
                              placeholder-text="Enter email"
                              class="input-field" />
            </ui:VisualElement>

            <!-- Username -->
            <ui:Label text="Username or Email" class="field-label" />
            <ui:TextField name="UsernameField"
                          placeholder-text="Enter username or email"
                          class="input-field" />

            <!-- Password -->
            <ui:Label text="Password" class="field-label" />
            <ui:VisualElement class="password-row">
                <ui:TextField name="PasswordField"
                              placeholder-text="Enter password"
                              password="true"
                              class="input-field password-row__field" />
                <ui:Button name="PasswordVisibilityButton"
                           tooltip="Show password"
                           class="password-visibility-button">
                    <ui:VisualElement class="password-eye-icon">
                        <ui:VisualElement class="password-eye-icon__pupil" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>

            <!-- Registration-only password confirmation -->
            <ui:VisualElement name="ConfirmPasswordContainer">
                <ui:Label text="Confirm Password" class="field-label" />
                <ui:VisualElement class="password-row">
                    <ui:TextField name="ConfirmPasswordField"
                                  placeholder-text="Re-enter password"
                                  password="true"
                                  class="input-field password-row__field" />
                    <ui:Button name="ConfirmPasswordVisibilityButton"
                               tooltip="Show password"
                               class="password-visibility-button">
                        <ui:VisualElement class="password-eye-icon">
                            <ui:VisualElement class="password-eye-icon__pupil" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Primary action -->
            <ui:Button name="LoginButton" text="Log In" class="btn-primary login-button" />

            <!-- Divider -->
            <ui:VisualElement class="divider" />

            <ui:VisualElement name="GoogleLoginContainer">
                <ui:Button name="GoogleLoginButton" text="Sign in with Google" class="google-login-button">
                    <ui:VisualElement class="google-login-button__icon" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>

            <!-- Switch between login and registration -->
            <ui:Button name="AuthModeButton" text="Create an account" class="btn-secondary" />

            <!-- Feedback message -->
            <ui:Label name="MessageLabel" text="" class="feedback" />

        </ui:VisualElement>
    </ui:VisualElement>

</ui:UXML>
