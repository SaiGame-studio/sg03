/* Import shared design tokens */
@import url("../Common/Variables.uss");

/* Login-specific: fixed card width */
.card {
    width: 380px;
}

.game-name {
    margin-top: -10px;
    margin-bottom: 16px;
    color: rgb(180, 200, 255);
    font-size: 15px;
    -unity-text-align: middle-center;
}

#RegisterFields {
    display: none;
}

#ConfirmPasswordContainer {
    display: none;
}

.google-login-button {
    margin-top: 12px;
    position: relative;
    padding: 20px 44px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(116, 119, 117);
    background-color: rgb(255, 255, 255);
    color: rgb(31, 31, 31);
    font-size: 14px;
    -unity-font-style: bold;
    cursor: link;
}

.google-login-button:hover {
    background-color: rgb(248, 250, 255);
    border-color: rgb(116, 119, 117);
}

.google-login-button:active {
    background-color: rgb(241, 243, 244);
}

.google-login-button:disabled {
    background-color: rgb(245, 245, 245);
    color: rgb(154, 160, 166);
}

.google-login-button__icon {
    position: absolute;
    left: 12px;
    top: 50%;
    translate: 0 -50%;
    width: 20px;
    height: 20px;
    background-image: url("project://database/Assets/_sg03/UI/Images/google.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.login-button {
    margin-top: 12px;
}

.password-row {
    position: relative;
    flex-direction: row;
    align-items: center;
}

.password-row__field {
    flex-grow: 1;
}

.password-row__field .unity-text-input,
.password-row__field .unity-base-text-field__input {
    padding-right: 46px;
}

.password-visibility-button {
    position: absolute;
    right: 13px;
    top: 50%;
    translate: 0 -50%;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: 8px;
    border-width: 0;
    background-color: transparent;
    color: rgb(180, 200, 255);
    font-size: 13px;
    align-items: center;
    justify-content: center;
}

.password-visibility-button:hover {
    background-color: rgba(60, 80, 140, 0.65);
}

/* CSS-only icon: safe in WebGL because it does not rely on a font glyph. */
.password-eye-icon {
    position: relative;
    width: 15px;
    height: 9px;
    border-width: 2px;
    border-radius: 50%;
    border-color: rgb(180, 200, 255);
}

.password-eye-icon__pupil {
    position: absolute;
    left: 4px;
    top: 1px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: rgb(180, 200, 255);
}

.password-visibility-button:hover .password-eye-icon {
    border-color: rgb(230, 238, 255);
}

.password-visibility-button:hover .password-eye-icon__pupil {
    background-color: rgb(230, 238, 255);
}
