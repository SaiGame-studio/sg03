<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="InventoryContent.uss" />

    <!-- Inventory content — header + category filter + scrollable item grid -->
    <ui:VisualElement name="InventoryRoot" class="inv-root">

        <!-- Header bar -->
        <ui:VisualElement class="inv-header">
            <ui:Label text="Inventory" class="inv-header__title" />
            <ui:Button name="RefreshBtn" text="↻" tooltip="Refresh" class="inv-header__refresh-btn" />
        </ui:VisualElement>

        <!-- Category filter tabs (populated at runtime) -->
        <ui:VisualElement name="CategoryBar" class="inv-category-bar" />

        <!-- Loading state -->
        <ui:VisualElement name="LoadingState" class="inv-state">
            <ui:Label text="⏳" class="inv-state__icon" />
            <ui:Label text="Loading inventory…" class="inv-state__label" />
        </ui:VisualElement>

        <!-- Empty state (no items) -->
        <ui:VisualElement name="EmptyState" class="inv-state">
            <ui:Label text="I" class="inv-state__icon" />
            <ui:Label text="No items found" class="inv-state__label" />
        </ui:VisualElement>

        <!-- Scrollable item grid (populated at runtime) -->
        <ui:ScrollView name="ItemGrid" class="inv-grid" />

        <!-- Gacha pack detail drawer -->
        <ui:VisualElement name="GachaPackDetailPanel" class="gacha-pack-detail-panel gacha-pack-detail-panel--hidden">
            <ui:VisualElement class="gacha-pack-detail-panel__header">
                <ui:Label text="Gacha Pack Details" class="gacha-pack-detail-panel__title" />
                <ui:Button name="CloseGachaPackDetailButton" text="×" tooltip="Close" class="gacha-pack-detail-panel__close" />
            </ui:VisualElement>
            <ui:ScrollView class="gacha-pack-detail-panel__scroll">
                <ui:VisualElement name="GachaPackDetailContent" class="gacha-pack-detail-panel__content" />
            </ui:ScrollView>
            <ui:VisualElement class="gacha-pack-detail-panel__actions">
                <ui:DropdownField name="GachaPackSelector" class="gacha-pack-detail-panel__selector" />
                <ui:Button name="OpenGachaPackButton" text="Open Pack" class="gacha-pack-detail-panel__open-button" />
                <ui:Label name="GachaPackOpenStatus" text="" class="gacha-pack-detail-panel__status" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
