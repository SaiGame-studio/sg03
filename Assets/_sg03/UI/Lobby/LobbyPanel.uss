/* Import shared design tokens */
@import url("../Common/Variables.uss");

/* ============================================================
   Lobby root — full screen, column layout
   ============================================================ */
/* Full-screen background — shows letterbox/pillarbox bars */
.lobby-root {
    flex: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 1);
}

/* 16:9 viewport — position: absolute here from the start so LobbyAspectRatioKeeper
   only needs to update width/height/left/top, never the position type itself.
   Changing position type at runtime on an overflow:hidden element corrupts the
   MeshGenerationContext Begin/End state and causes InvalidOperationException. */
.lobby-viewport {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(10, 12, 20, 0.97);
}

/* ============================================================
   Top menu bar
   ============================================================ */
.lobby-top-menu {
    flex-direction: row;
    align-items: center;
    height: 56px;
    min-height: 56px;
    background-color: rgba(16, 20, 36, 1);
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 0 20px;
}

.lobby-top-menu__title {
    font-size: 16px;
    color: rgb(200, 210, 255);
    -unity-font-style: bold;
    margin-right: 24px;
    letter-spacing: 1px;
}

.lobby-top-menu__tabs {
    flex-direction: row;
    flex: 1;
    align-items: center;
}

.lobby-tab {
    padding: 8px 18px;
    border-radius: 8px;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    margin-right: 4px;
    transition-duration: 0.12s;
}

.lobby-tab:hover {
    background-color: rgba(80, 100, 160, 0.25);
    color: rgb(200, 215, 255);
}

.lobby-tab--active {
    background-color: rgba(60, 110, 230, 0.25);
    color: rgb(110, 160, 255);
    -unity-font-style: bold;
}

.lobby-top-menu__player-name {
    font-size: 13px;
    color: rgb(180, 195, 240);
    -unity-font-style: bold;
    margin-left: 16px;
    -unity-text-align: middle-right;
}

.soul-energy {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

.soul-energy__icon {
    color: rgb(210, 190, 255);
    font-size: 13px;
    margin-right: 4px;
    transition-duration: 0.12s;
}

.soul-energy__value {
    color: rgb(214, 207, 240);
    font-size: 10px;
    transition-duration: 0.12s;
}

.soul-energy:hover {
    background-color: transparent;
}

.soul-energy:hover .soul-energy__icon,
.soul-energy:hover .soul-energy__value {
    color: rgb(255, 220, 128);
}

.soul-energy-popup {
    position: absolute;
    width: 164px;
    padding: 9px 10px;
    background-color: rgb(23, 19, 42);
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(132, 94, 255, 0.7);
}

.soul-energy-popup__title {
    color: rgb(222, 212, 255);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.soul-energy-popup__row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 2px;
}

.soul-energy-popup__label {
    color: rgb(164, 155, 196);
    font-size: 11px;
}

.soul-energy-popup__value {
    color: rgb(235, 229, 255);
    font-size: 11px;
    -unity-font-style: bold;
    margin-left: 14px;
}

.lobby-top-menu__logout {
    width: 30px;
    height: 30px;
    margin-left: 8px;
    padding: 0;
    font-size: 18px;
    color: rgb(180, 195, 240);
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-center;
}

.lobby-top-menu__logout:hover {
    color: rgb(255, 140, 140);
    background-color: rgba(220, 80, 80, 0.18);
}

.lobby-top-menu__quit {
    width: 30px;
    height: 30px;
    margin-left: 4px;
    padding: 0;
    color: rgb(255, 170, 150);
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.lobby-top-menu__quit:hover {
    color: rgb(255, 220, 220);
    background-color: rgba(220, 80, 80, 0.35);
}

.power-off-icon {
    position: relative;
    width: 14px;
    height: 14px;
    border-width: 2px;
    border-radius: 50%;
    border-color: rgb(255, 170, 150);
}

.power-off-icon__stem {
    position: absolute;
    left: 4px;
    top: -4px;
    width: 2px;
    height: 8px;
    background-color: rgb(255, 170, 150);
}

.lobby-top-menu__quit:hover .power-off-icon {
    border-color: rgb(255, 220, 220);
}

.lobby-top-menu__quit:hover .power-off-icon__stem {
    background-color: rgb(255, 220, 220);
}

.quit-confirm-overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 8, 16, 0.88);
    align-items: center;
    justify-content: center;
}

.quit-confirm-card {
    min-width: 360px;
    padding: 28px;
    background-color: rgba(22, 26, 40, 1);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.45);
    align-items: center;
}

.quit-confirm-title {
    font-size: 22px;
    color: rgb(240, 244, 255);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.quit-confirm-message {
    font-size: 14px;
    color: rgb(180, 195, 240);
    margin-bottom: 24px;
    -unity-text-align: middle-center;
}

.quit-confirm-actions {
    flex-direction: row;
    justify-content: center;
}

.quit-confirm-button {
    min-width: 100px;
    margin: 0 6px;
    padding: 9px 14px;
    color: rgb(220, 228, 255);
    background-color: rgba(80, 100, 160, 0.45);
    border-width: 0;
    border-radius: 6px;
}

.quit-confirm-button--danger {
    color: rgb(255, 225, 225);
    background-color: rgba(190, 48, 48, 0.9);
}

/* ============================================================
   Content area
   ============================================================ */
.lobby-content {
    flex: 1;
    align-items: center;
    justify-content: center;
}

/* ============================================================
   Bottom navigation bar
   ============================================================ */
.lobby-bottom-menu {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    height: 64px;
    min-height: 64px;
    background-color: rgba(16, 20, 36, 1);
    border-top-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 0 12px;
}

.lobby-bottom-btn {
    flex: 1;
    margin: 0 6px;
    padding: 10px 8px;
    border-radius: 10px;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    transition-duration: 0.12s;
    -unity-text-align: middle-center;
}

.lobby-bottom-btn:hover {
    background-color: rgba(80, 100, 160, 0.25);
    color: rgb(200, 215, 255);
}

.lobby-bottom-btn--primary {
    background-color: rgba(60, 110, 230, 1);
    color: rgb(240, 244, 255);
    -unity-font-style: bold;
}

.lobby-bottom-btn--primary:hover {
    background-color: rgba(80, 130, 255, 1);
}

/* ============================================================
   Immersive mode — reveal 3D scene behind the lobby
   ============================================================ */
.lobby-root--immersive {
    background-color: transparent;
}

.lobby-viewport--immersive {
    background-color: transparent;
}
