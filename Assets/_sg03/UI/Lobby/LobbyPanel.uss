/* Import shared design tokens */
@import url("../../../SaiGame/UI/Common/Variables.uss");

/* ============================================================
   Lobby root — full screen, column layout
   ============================================================ */
/* Full-screen background — shows letterbox/pillarbox bars */
.lobby-root {
    flex: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 1);
}

/* 16:9 viewport — absolute position and size set at runtime by LobbyAspectRatioKeeper */
/* flex: 1 + height: 100% ensures the column has an explicit height before the keeper fires,
   so BottomMenu always stays at the bottom even when ContentArea is empty. */
.lobby-viewport {
    flex: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    background-color: rgba(10, 12, 20, 0.97);
}

/* ============================================================
   Top menu bar
   ============================================================ */
.lobby-top-menu {
    flex-direction: row;
    align-items: center;
    height: 56px;
    min-height: 56px;
    background-color: rgba(16, 20, 36, 1);
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 0 20px;
}

.lobby-top-menu__title {
    font-size: 16px;
    color: rgb(200, 210, 255);
    -unity-font-style: bold;
    margin-right: 24px;
    letter-spacing: 1px;
}

.lobby-top-menu__tabs {
    flex-direction: row;
    flex: 1;
    align-items: center;
}

.lobby-tab {
    padding: 8px 18px;
    border-radius: 8px;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    margin-right: 4px;
    transition-duration: 0.12s;
}

.lobby-tab:hover {
    background-color: rgba(80, 100, 160, 0.25);
    color: rgb(200, 215, 255);
}

.lobby-tab--active {
    background-color: rgba(60, 110, 230, 0.25);
    color: rgb(110, 160, 255);
    -unity-font-style: bold;
}

.lobby-top-menu__player-name {
    font-size: 13px;
    color: rgb(180, 195, 240);
    -unity-font-style: bold;
    margin-left: 16px;
    -unity-text-align: middle-right;
}

/* ============================================================
   Content area
   ============================================================ */
.lobby-content {
    flex: 1;
    align-items: center;
    justify-content: center;
}

/* ============================================================
   Bottom navigation bar
   ============================================================ */
.lobby-bottom-menu {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    height: 64px;
    min-height: 64px;
    background-color: rgba(16, 20, 36, 1);
    border-top-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 0 12px;
}

.lobby-bottom-btn {
    flex: 1;
    margin: 0 6px;
    padding: 10px 8px;
    border-radius: 10px;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    transition-duration: 0.12s;
    -unity-text-align: middle-center;
}

.lobby-bottom-btn:hover {
    background-color: rgba(80, 100, 160, 0.25);
    color: rgb(200, 215, 255);
}

.lobby-bottom-btn--primary {
    background-color: rgba(60, 110, 230, 1);
    color: rgb(240, 244, 255);
    -unity-font-style: bold;
}

.lobby-bottom-btn--primary:hover {
    background-color: rgba(80, 130, 255, 1);
}

/* ============================================================
   Immersive mode — reveal 3D scene behind the lobby
   ============================================================ */
.lobby-root--immersive {
    background-color: transparent;
}

.lobby-viewport--immersive {
    background-color: transparent;
}
