<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="LobbyPanel.uss" />
    <!-- Full-screen root — fills the panel, shows letterbox/pillarbox bars -->
    <ui:VisualElement name="LobbyRoot" class="lobby-root">

        <!-- 16:9 viewport — sized at runtime by LobbyAspectRatioKeeper -->
        <ui:VisualElement name="LobbyViewport" class="lobby-viewport">

            <!-- Top menu bar -->
            <ui:VisualElement name="TopMenu" class="lobby-top-menu">
                <ui:Label name="AppTitle" text="SaiGame" class="lobby-top-menu__title" />
                <ui:VisualElement name="TopMenuTabs" class="lobby-top-menu__tabs">
                    <ui:Button name="HomeTab"    text="Home"    class="lobby-tab lobby-tab--active" />
                    <ui:Button name="ShopTab"    text="Shop"    class="lobby-tab" />
                    <ui:Button name="QuestTab"   text="Quest"   class="lobby-tab" />
                </ui:VisualElement>
                <ui:Label name="PlayerNameLabel" text="👤 Guest" class="lobby-top-menu__player-name" />
            </ui:VisualElement>

            <!-- Content area (expands to fill remaining space) -->
            <ui:VisualElement name="ContentArea" class="lobby-content" />

            <!-- Bottom navigation bar -->
            <ui:VisualElement name="BottomMenu" class="lobby-bottom-menu">
                <ui:Button name="BtnProfile"   text="👤 Profile"   class="lobby-bottom-btn" />
                <ui:Button name="BtnDesk"      text="🃏 Desk"      class="lobby-bottom-btn" />
                <ui:Button name="BtnInventory" text="🎒 Inventory" class="lobby-bottom-btn" />
                <ui:Button name="BtnMailbox"   text="📬 Mailbox"   class="lobby-bottom-btn" />
                <ui:Button name="BtnPlay"      text="▶  Play"      class="lobby-bottom-btn lobby-bottom-btn--primary" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
