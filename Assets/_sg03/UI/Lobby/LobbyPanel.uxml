<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="LobbyPanel.uss" />
    <!-- Full-screen root — fills the panel, shows letterbox/pillarbox bars -->
    <ui:VisualElement name="LobbyRoot" class="lobby-root">

        <!-- 16:9 viewport — sized at runtime by LobbyAspectRatioKeeper -->
        <ui:VisualElement name="LobbyViewport" class="lobby-viewport">

            <!-- Top menu bar -->
            <ui:VisualElement name="TopMenu" class="lobby-top-menu">
                <ui:Label name="AppTitle" text="SaiGame" class="lobby-top-menu__title" />
                <ui:VisualElement name="TopMenuTabs" class="lobby-top-menu__tabs">
                    <ui:Button name="QuestTab"   text="Quest"   class="lobby-tab lobby-tab--active" />
                    <ui:Button name="ShopTab"    text="Shop"    class="lobby-tab" />
                    <ui:Button name="SoulEnergy" class="soul-energy" tooltip="Soul Collector">
                        <ui:Label text="✦" tooltip="Soul Energy" class="soul-energy__icon" />
                        <ui:Label name="SoulEnergyValue" text="0 / 0" class="soul-energy__value" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label name="PlayerNameLabel" text="👤 Guest" class="lobby-top-menu__player-name" />
                <ui:Button name="BtnLogout" text="←" tooltip="Log out" class="lobby-top-menu__logout" />
                <ui:Button name="BtnQuitGame" tooltip="Power off" class="lobby-top-menu__quit">
                    <ui:VisualElement class="power-off-icon">
                        <ui:VisualElement class="power-off-icon__stem" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>

            <!-- Content area (expands to fill remaining space) -->
            <ui:VisualElement name="ContentArea" class="lobby-content" />

            <!-- Bottom navigation bar -->
            <ui:VisualElement name="BottomMenu" class="lobby-bottom-menu">
                <ui:Button name="BtnDesk"      text="🃏 Desk"      class="lobby-bottom-btn" />
                <ui:Button name="BtnInventory" text="🎒 Inventory" class="lobby-bottom-btn" />
                <ui:Button name="BtnMailbox"   text="📬 Mailbox"   class="lobby-bottom-btn" />
                <ui:Button name="BtnPlay"      text="▶  Play"      class="lobby-bottom-btn lobby-bottom-btn--primary" />
            </ui:VisualElement>

            <ui:VisualElement name="QuitConfirmOverlay" class="quit-confirm-overlay" style="display: none;">
                <ui:VisualElement class="quit-confirm-card">
                    <ui:Label text="Quit game?" class="quit-confirm-title" />
                    <ui:Label text="Are you sure you want to close the game?" class="quit-confirm-message" />
                    <ui:VisualElement class="quit-confirm-actions">
                        <ui:Button name="BtnCancelQuit" text="Cancel" class="quit-confirm-button" />
                        <ui:Button name="BtnConfirmQuit" text="Quit" class="quit-confirm-button quit-confirm-button--danger" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="SoulEnergyPopup" class="soul-energy-popup" style="display: none;">
            <ui:Label text="Soul Collector" class="soul-energy-popup__title" />
            <ui:VisualElement name="SoulEnergyClaimRow" class="soul-energy-popup__row">
                <ui:Label text="Claim now" class="soul-energy-popup__label" />
                <ui:Label name="SoulEnergyClaimValue" text="0" class="soul-energy-popup__value" />
            </ui:VisualElement>
            <ui:VisualElement name="SoulEnergyNextClaimRow" class="soul-energy-popup__row" style="display: none;">
                <ui:Label text="Next claim in" class="soul-energy-popup__label" />
                <ui:Label name="SoulEnergyNextClaimValue" text="—" class="soul-energy-popup__value" />
            </ui:VisualElement>
            <ui:VisualElement name="SoulEnergyFullRow" class="soul-energy-popup__row">
                <ui:Label name="SoulEnergyFullLabel" text="Full in" class="soul-energy-popup__label" />
                <ui:Label name="SoulEnergyFullValue" text="—" class="soul-energy-popup__value" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
