@import url("../Common/Variables.uss");

.game-root {
    flex: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: transparent;
}

.game-viewport {
    flex: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    background-color: transparent;
}

.game-top-menu {
    flex-direction: row;
    align-items: center;
    height: 56px;
    min-height: 56px;
    background-color: rgba(16, 20, 36, 0.92);
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 0 20px;
}

.game-top-menu__title {
    font-size: 16px;
    color: rgb(200, 210, 255);
    -unity-font-style: bold;
    margin-right: 24px;
    letter-spacing: 1px;
}

.game-top-menu__tabs {
    flex-direction: row;
    flex: 1;
    align-items: center;
}

.game-tab {
    padding: 8px 18px;
    border-radius: 8px;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    margin-right: 4px;
    transition-duration: 0.12s;
}

.game-tab:hover {
    background-color: rgba(80, 100, 160, 0.25);
    color: rgb(200, 215, 255);
}

.game-tab--active {
    background-color: rgba(60, 110, 230, 0.25);
    color: rgb(110, 160, 255);
    -unity-font-style: bold;
}

.game-tab--loader {
    background-color: rgba(38, 46, 68, 0.86);
    color: rgb(210, 220, 245);
}

.game-tab--loader:hover {
    background-color: rgba(58, 68, 96, 0.92);
    color: rgb(240, 244, 255);
}

.game-top-menu__player-name {
    font-size: 13px;
    color: rgb(180, 195, 240);
    -unity-font-style: bold;
    margin-left: 16px;
    -unity-text-align: middle-right;
}

.game-top-menu__card-count {
    min-width: 112px;
    font-size: 13px;
    color: rgb(220, 228, 255);
    -unity-font-style: bold;
    margin-left: 16px;
    -unity-text-align: middle-right;
}

.game-world-view-space {
    flex: 1;
    width: 100%;
    position: relative;
    background-color: transparent;
}

.battle-hp-label {
    position: absolute;
    left: 18px;
    min-width: 132px;
    padding: 8px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.42);
    background-color: rgba(16, 20, 36, 0.82);
    color: rgb(235, 240, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.battle-hp-label--omega {
    top: 18px;
}

.battle-hp-label--alpha {
    bottom: 18px;
}

.battle-source-count-label {
    position: absolute;
    right: 18px;
    min-width: 132px;
    padding: 8px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.42);
    background-color: rgba(16, 20, 36, 0.82);
    color: rgb(235, 240, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.battle-source-count-label--top-right {
    top: 18px;
}

.battle-source-count-label--top-right-2 {
    top: 72px;
}

.battle-source-count-label--bottom-right {
    bottom: 18px;
}

.battle-source-count-label--bottom-right-2 {
    bottom: 72px;
}

.game-bottom-menu {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    height: 64px;
    min-height: 64px;
    background-color: rgba(16, 20, 36, 0.92);
    border-top-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
    padding: 0 12px;
}

.game-bottom-btn {
    flex: 1;
    margin: 0 6px;
    padding: 10px 8px;
    border-radius: 10px;
    border-width: 0;
    background-color: transparent;
    color: rgb(150, 160, 200);
    font-size: 13px;
    transition-duration: 0.12s;
    -unity-text-align: middle-center;
}

.game-bottom-btn:hover {
    background-color: rgba(80, 100, 160, 0.25);
    color: rgb(200, 215, 255);
}

.game-bottom-input {
    flex: 1.25;
    margin: 0 6px;
    min-width: 160px;
    color: rgb(220, 228, 255);
    font-size: 13px;
}

.game-bottom-input .unity-label {
    min-width: 46px;
    color: rgb(180, 195, 240);
    -unity-font-style: bold;
}

.game-bottom-input .unity-text-input {
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.45);
    background-color: rgba(38, 46, 68, 0.86);
    color: rgb(240, 244, 255);
    padding: 6px 8px;
}

.game-bottom-btn--secondary {
    background-color: rgba(38, 46, 68, 0.86);
    color: rgb(210, 220, 245);
}

.game-bottom-btn--secondary:hover {
    background-color: rgba(58, 68, 96, 0.92);
    color: rgb(240, 244, 255);
}

.game-bottom-btn--primary {
    background-color: rgba(60, 110, 230, 1);
    color: rgb(240, 244, 255);
    -unity-font-style: bold;
}

.game-bottom-btn--primary:hover {
    background-color: rgba(80, 130, 255, 1);
}

/* Enemy input and Start Battle button placed inside TopMenu — compact size */
.game-top-menu .game-bottom-input {
    flex: 0 0 auto;
    min-width: 150px;
    max-width: 260px;
    font-size: 11px;
    margin: 0 4px;
}

.game-top-menu .game-bottom-input .unity-text-input {
    padding: 2px 6px;
    color: rgb(180, 0, 0);
}

.game-top-menu .game-bottom-btn--primary {
    flex: 0 0 auto;
    padding: 4px 10px;
    font-size: 11px;
    margin: 0 4px;
}