<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:uie="UnityEditor.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
         editor-extension-mode="False">

    <Style src="GamePanel.uss" />

    <ui:VisualElement name="GameRoot" class="game-root">

        <ui:VisualElement name="GameViewport" class="game-viewport">

            <ui:VisualElement name="TopMenu" class="game-top-menu">
                <ui:Label name="BattleTitle" text="Omega" class="game-top-menu__title" />
                <ui:DropdownField name="EnemyCodeNameInput" label="Enemy" choices="goblin_shaman" value="goblin_shaman" class="game-bottom-input" />
                <ui:VisualElement name="PlayerNavigation">
                    <ui:Button name="SoulEnergy" class="soul-energy" tooltip="Soul Collector">
                        <ui:Label text="✦" tooltip="Soul Energy" class="soul-energy__icon" />
                        <ui:Label name="SoulEnergyValue" text="0 / 0" class="soul-energy__value" />
                    </ui:Button>
                    <ui:Label name="PlayerNameLabel" text="Guest" class="game-top-menu__player-name" />
                    <ui:Button name="BtnBackToLobby" text="Lobby" class="game-bottom-btn game-bottom-btn--secondary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="WorldViewSpace" class="game-world-view-space">
                <ui:Label name="OmegaHpLabel" text="HP: --" class="battle-hp-label battle-hp-label--omega" />
                <ui:Label name="AlphaHpLabel" text="HP: --" class="battle-hp-label battle-hp-label--alpha" />
                <ui:Label name="OmeraSourceCountLabel" text="Source: --" class="battle-source-count-label battle-source-count-label--top-right" />
                <ui:Label name="OmegaTheVoidCountLabel" text="Void: --" class="battle-source-count-label battle-source-count-label--top-right-2" />
                <ui:Label name="AlphaTheVoidCountLabel" text="Void: --" class="battle-source-count-label battle-source-count-label--bottom-right-2" />
                <ui:Label name="AlphaSourceCountLabel" text="Source: --" class="battle-source-count-label battle-source-count-label--bottom-right" />
            </ui:VisualElement>

            <ui:VisualElement name="BottomMenu" class="game-bottom-menu">
                <ui:Label name="AlphaLabel" text="Alpha" class="game-top-menu__title" />
                <ui:Button name="BtnStartBattle" text="Start with 5 soul" class="game-bottom-btn game-bottom-btn--primary" />
                <ui:Button name="BtnEndBattle" text="End Game" class="game-bottom-btn game-bottom-btn--danger" style="display: none;" />
                <ui:VisualElement name="BattleDeskInfo" class="game-bottom-menu__desk-info">
                    <ui:VisualElement name="DeskTabs" class="game-top-menu__tabs">
                    </ui:VisualElement>
                    <ui:Label name="CardCountLabel" text="Card Count: 0" class="game-top-menu__card-count" />
                </ui:VisualElement>

                <ui:Label name="NextMoveLabel" text="Move: --" class="game-top-menu__title" style="margin-left: auto;" />
            </ui:VisualElement>

        </ui:VisualElement>

        <ui:VisualElement name="SoulEnergyPopup" class="soul-energy-popup" style="display: none;">
            <ui:Label text="Soul Collector" class="soul-energy-popup__title" />
            <ui:VisualElement name="SoulEnergyClaimRow" class="soul-energy-popup__row">
                <ui:Label text="Claim now" class="soul-energy-popup__label" />
                <ui:Label name="SoulEnergyClaimValue" text="0" class="soul-energy-popup__value" />
            </ui:VisualElement>
            <ui:VisualElement name="SoulEnergyNextClaimRow" class="soul-energy-popup__row" style="display: none;">
                <ui:Label text="Next claim in" class="soul-energy-popup__label" />
                <ui:Label name="SoulEnergyNextClaimValue" text="—" class="soul-energy-popup__value" />
            </ui:VisualElement>
            <ui:VisualElement name="SoulEnergyFullRow" class="soul-energy-popup__row">
                <ui:Label name="SoulEnergyFullLabel" text="Full in" class="soul-energy-popup__label" />
                <ui:Label name="SoulEnergyFullValue" text="—" class="soul-energy-popup__value" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
