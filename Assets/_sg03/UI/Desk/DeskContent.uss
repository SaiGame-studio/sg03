@import url("../Common/Variables.uss");

/* ============================================================
   Desk content root — fills ContentArea
   ============================================================ */
.desk-root {
    flex: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 12, 20, 0.97);
}

/* Immersive mode — transparent background to reveal 3D scene */
.desk-root--immersive {
    background-color: transparent;
}

/* Compact scrollbar shared with Inventory and Daily Quest details. */
.desk-root .unity-scroll-view__vertical-scroller {
    width: 9px;
    margin-left: 5px;
    background-color: transparent;
    border-radius: 2px;
}

.desk-root .unity-scroller__low-button,
.desk-root .unity-scroller__high-button {
    display: none;
}

.desk-root .unity-scroller__slider {
    background-color: transparent;
}

.desk-root .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.desk-root .unity-base-slider__dragger {
    width: 9px;
    min-width: 9px;
    max-width: 9px;
    min-height: 20px;
    align-self: center;
    background-color: rgba(130, 160, 220, 0.34);
    border-width: 0;
    border-radius: 2px;
}

.desk-root .unity-base-slider__dragger:hover,
.desk-root .unity-base-slider__dragger:active {
    background-color: rgba(145, 190, 255, 0.82);
}

/* ============================================================
   Header bar
   ============================================================ */
.desk-header {
    flex-direction: row;
    align-items: center;
    height: 52px;
    min-height: 52px;
    padding: 0 24px;
    background-color: rgba(16, 20, 36, 1);
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
}

.desk-header__title {
    flex: 1;
    font-size: 15px;
    color: rgb(200, 210, 255);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.desk-header__title--hidden,
.desk-header__rename-input--hidden,
.desk-header__rename-btn--hidden,
.desk-header__save-name-btn--hidden {
    display: none;
}

.desk-header__rename-input {
    flex: 1;
    margin-right: 8px;
    padding: 5px 9px;
    border-width: 1px;
    border-color: rgba(100, 150, 240, 0.6);
    border-radius: 6px;
    background-color: rgba(28, 34, 58, 1);
    color: rgb(220, 230, 255);
    font-size: 13px;
}

.desk-header__rename-input > .unity-text-field__input {
    padding: 0;
    border-width: 0;
    background-color: transparent;
    color: rgb(220, 230, 255);
}

.desk-header__rename-btn,
.desk-header__save-name-btn {
    padding: 6px 12px;
    border-width: 1px;
    border-radius: 8px;
    font-size: 12px;
    transition-duration: 0.1s;
}

.desk-header__rename-btn {
    border-color: rgba(100, 150, 240, 0.5);
    background-color: rgba(35, 55, 105, 0.7);
    color: rgb(165, 200, 255);
}

.desk-header__rename-btn:hover {
    background-color: rgba(55, 85, 150, 0.8);
    color: rgb(210, 225, 255);
}

.desk-header__save-name-btn {
    border-color: rgba(100, 200, 120, 0.5);
    background-color: rgba(30, 80, 40, 0.8);
    color: rgb(140, 220, 150);
}

.desk-header__save-name-btn:hover {
    background-color: rgba(40, 110, 55, 0.9);
    color: rgb(180, 245, 185);
}

.desk-header__new-btn {
    padding: 6px 16px;
    margin-right: 8px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(100, 200, 120, 0.5);
    background-color: rgba(30, 80, 40, 0.7);
    color: rgb(140, 220, 150);
    font-size: 12px;
    -unity-font-style: bold;
    transition-duration: 0.1s;
}

.desk-header__new-btn:hover {
    background-color: rgba(40, 110, 55, 0.85);
    color: rgb(180, 245, 185);
}

.desk-header__refresh-btn {
    width: 32px;
    height: 28px;
    padding: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.4);
    background-color: rgba(40, 50, 80, 0.6);
    color: rgb(150, 160, 200);
    font-size: 16px;
    transition-duration: 0.1s;
}

.desk-header__refresh-btn:hover {
    background-color: rgba(60, 80, 130, 0.7);
    color: rgb(200, 215, 255);
}

/* ============================================================
   Create form (inline, below header)
   ============================================================ */
.desk-create-form {
    flex-direction: row;
    align-items: center;
    padding: 10px 24px;
    background-color: rgba(20, 25, 44, 1);
    border-bottom-width: 1px;
    border-color: rgba(100, 200, 120, 0.25);
}

.desk-create-form__input {
    flex: 1;
    margin-right: 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.45);
    background-color: rgba(28, 34, 58, 1);
    color: rgb(200, 210, 255);
    font-size: 12px;
    padding: 6px 10px;
}

.desk-create-form__input > .unity-text-field__input {
    background-color: transparent;
    color: rgb(200, 210, 255);
    border-width: 0;
    padding: 0;
}

.desk-create-form__confirm-btn {
    padding: 6px 18px;
    margin-right: 6px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(100, 200, 120, 0.5);
    background-color: rgba(30, 80, 40, 0.8);
    color: rgb(140, 220, 150);
    font-size: 12px;
    -unity-font-style: bold;
    transition-duration: 0.1s;
}

.desk-create-form__confirm-btn:hover {
    background-color: rgba(40, 110, 55, 0.9);
    color: rgb(180, 245, 185);
}

.desk-create-form__cancel-btn {
    padding: 6px 14px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(180, 80, 80, 0.4);
    background-color: rgba(60, 25, 25, 0.6);
    color: rgb(200, 140, 140);
    font-size: 12px;
    transition-duration: 0.1s;
}

.desk-create-form__cancel-btn:hover {
    background-color: rgba(90, 35, 35, 0.8);
    color: rgb(240, 170, 170);
}

/* ============================================================
   State views — loading and empty
   ============================================================ */
.desk-state {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.desk-state__icon {
    font-size: 40px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.desk-state__label {
    font-size: 14px;
    color: rgb(130, 145, 185);
    -unity-text-align: middle-center;
}

/* ============================================================
   Scrollable desk list
   ============================================================ */
.desk-list {
    flex: 1;
    padding: 16px;
}

/* ============================================================
   Desk row card
   ============================================================ */
.desk-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(22, 26, 40, 1);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.25);
    padding: 14px 16px;
    margin-bottom: 10px;
    transition-duration: 0.1s;
}

.desk-row:hover {
    background-color: rgba(30, 36, 58, 1);
    border-color: rgba(100, 130, 220, 0.45);
}

.desk-row__icon {
    font-size: 24px;
    margin-right: 14px;
    -unity-text-align: middle-center;
    min-width: 32px;
}

.desk-row__info {
    flex: 1;
    flex-direction: column;
}

.desk-row__name {
    font-size: 14px;
    color: rgb(210, 220, 255);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.desk-row__meta {
    font-size: 10px;
    color: rgb(100, 115, 160);
    letter-spacing: 0.5px;
}

.desk-row__delete-btn {
    padding: 4px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(200, 60, 60, 0.5);
    background-color: rgba(80, 20, 20, 0.7);
    color: rgb(220, 100, 100);
    font-size: 14px;
    -unity-font-style: bold;
    transition-duration: 0.1s;
}

.desk-row__delete-btn:hover {
    background-color: rgba(140, 30, 30, 0.85);
    border-color: rgba(220, 80, 80, 0.7);
}

/* ============================================================
   Panel switching
   ============================================================ */
.desk-panel {
    flex: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.desk-panel--hidden {
    display: none;
}

/* ============================================================
   Back button (detail header)
   ============================================================ */
.desk-header__back-btn {
    padding: 6px 14px;
    margin-right: 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.4);
    background-color: rgba(40, 50, 80, 0.6);
    color: rgb(150, 160, 200);
    font-size: 12px;
    transition-duration: 0.1s;
}

.desk-header__back-btn:hover {
    background-color: rgba(60, 80, 130, 0.7);
    color: rgb(200, 215, 255);
}

.desk-row__default-btn {
    padding: 4px 8px;
    margin-right: 8px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(220, 175, 60, 0.6);
    background-color: rgba(100, 75, 20, 0.7);
    color: rgb(255, 220, 120);
    font-size: 10px;
}

.desk-row__default-btn:hover {
    background-color: rgba(150, 110, 25, 0.85);
}

.desk-row__default-text {
    margin-right: 8px;
    color: rgb(90, 150, 255);
    font-size: 10px;
    -unity-font-style: bold;
}

.desk-header__soft-card-btn {
    padding: 6px 14px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(210, 165, 75, 0.6);
    background-color: rgba(100, 68, 25, 0.65);
    color: rgb(255, 220, 145);
    font-size: 12px;
    -unity-font-style: bold;
    transition-duration: 0.1s;
}

.desk-header__soft-card-btn:hover {
    background-color: rgba(135, 90, 30, 0.82);
    color: rgb(255, 238, 190);
}

/* ============================================================
   Slot grid
   ============================================================ */
.desk-slot-grid {
    flex: 1;
    padding: 16px;
}

.desk-slot-grid > #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
}

.desk-slot-grid > #unity-scroll-view > #unity-content-viewport > #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
}

/* Each slot tile */
.desk-slot {
    width: 100px;
    min-height: 140px;
    margin: 6px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(80, 100, 160, 0.3);
    background-color: rgba(20, 24, 40, 1);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    transition-duration: 0.1s;
}

.desk-slot--empty {
    border-color: rgba(80, 100, 160, 0.2);
    background-color: rgba(16, 20, 34, 1);
}

.desk-slot--empty:hover {
    border-color: rgba(100, 180, 120, 0.5);
    background-color: rgba(20, 40, 28, 0.8);
}

.desk-slot--filled {
    border-color: rgba(100, 140, 255, 0.4);
    background-color: rgba(22, 28, 52, 1);
}

.desk-slot__index {
    font-size: 9px;
    color: rgb(70, 85, 130);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.desk-slot__add-icon {
    font-size: 28px;
    color: rgb(80, 130, 90);
    -unity-text-align: middle-center;
}

.desk-slot__item-icon {
    height: 70px;
    flex-shrink: 0;
    margin-bottom: 0;
}

.desk-slot__item-name {
    font-size: 9px;
    color: rgb(160, 175, 220);
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-word-wrap: true;
    max-width: 88px;
}

.desk-slot__item-qty {
    font-size: 9px;
    color: rgb(100, 115, 160);
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* Slot action buttons (View / Remove) */
.desk-slot__actions {
    flex-direction: row;
    width: 92px;
    margin-top: 6px;
    margin-bottom: 4px;
}

.desk-slot__btn {
    flex: 1;
    font-size: 8px;
    padding: 3px 2px;
    margin: 0 1px;
    border-radius: 4px;
    border-width: 1px;
    -unity-text-align: middle-center;
    transition-duration: 0.1s;
}

.desk-slot__btn--view {
    background-color: rgba(30, 60, 130, 0.7);
    border-color: rgba(80, 130, 230, 0.5);
    color: rgb(150, 195, 255);
}

.desk-slot__btn--view:hover {
    background-color: rgba(50, 90, 180, 0.8);
    color: rgb(200, 225, 255);
}

.desk-slot__btn--remove {
    background-color: rgba(100, 20, 20, 0.7);
    border-color: rgba(200, 50, 50, 0.5);
    color: rgb(255, 120, 120);
}

.desk-slot__btn--remove:hover {
    background-color: rgba(160, 30, 30, 0.8);
    color: rgb(255, 170, 170);
}

/* ============================================================
   Item picker overlay
   ============================================================ */
.desk-picker {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 18, 0.94);
    flex-direction: column;
}

.desk-picker--hidden {
    display: none;
}

.desk-picker__header {
    flex-direction: row;
    align-items: center;
    height: 48px;
    min-height: 48px;
    padding: 0 20px;
    background-color: rgba(16, 20, 36, 1);
    border-bottom-width: 1px;
    border-color: rgba(80, 100, 160, 0.35);
}

.desk-picker__title {
    flex: 1;
    font-size: 14px;
    color: rgb(200, 210, 255);
    -unity-font-style: bold;
}

.desk-picker__close-btn {
    padding: 4px 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(180, 80, 80, 0.4);
    background-color: rgba(60, 25, 25, 0.6);
    color: rgb(200, 140, 140);
    font-size: 12px;
    transition-duration: 0.1s;
}

.desk-picker__close-btn:hover {
    background-color: rgba(90, 35, 35, 0.8);
    color: rgb(240, 170, 170);
}

.desk-picker__list {
    flex: 1;
    padding: 12px;
}

/* Item picker row */
.desk-picker-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(22, 26, 40, 1);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.2);
    padding: 10px 14px;
    margin-bottom: 8px;
    transition-duration: 0.1s;
}

.desk-picker-item:hover {
    background-color: rgba(30, 50, 90, 0.8);
    border-color: rgba(100, 140, 255, 0.5);
}

.desk-picker-item__icon {
    font-size: 22px;
    margin-right: 12px;
    min-width: 30px;
    -unity-text-align: middle-center;
}

.desk-picker-item__info {
    flex: 1;
    flex-direction: column;
}

.desk-picker-item__name {
    font-size: 13px;
    color: rgb(200, 215, 255);
    -unity-font-style: bold;
}

.desk-picker-item__meta {
    font-size: 10px;
    color: rgb(100, 115, 160);
    margin-top: 2px;
}

.desk-picker-item__qty {
    font-size: 12px;
    color: rgb(130, 160, 200);
    -unity-text-align: middle-right;
    min-width: 40px;
}

/* ============================================================
   Detail panel — split layout
   ============================================================ */
.desk-detail-body {
    flex: 1;
    flex-direction: row;
    overflow: hidden;
}

.desk-detail-left {
    flex: 1;
    flex-direction: column;
    overflow: hidden;
}

.desk-detail-right {
    width: 300px;
    min-width: 300px;
    flex-direction: column;
    overflow: hidden;
    padding: 10px 10px 10px 0;
    border-left-width: 1px;
    border-color: rgba(80, 100, 160, 0.25);
}

.desk-detail-section-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.desk-detail-section-title {
    font-size: 11px;
    color: rgb(120, 140, 200);
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    padding: 8px 12px 4px 12px;
}

.desk-detail-slot-count {
    font-size: 11px;
    color: rgb(100, 130, 180);
    padding: 8px 12px 4px 0;
}

.desk-detail-star-count {
    font-size: 11px;
    color: rgb(200, 170, 50);
    -unity-font-style: bold;
    padding: 8px 10px 4px 0;
}

.desk-detail-high-star-card-count {
    font-size: 11px;
    color: rgb(235, 190, 70);
    -unity-font-style: bold;
    padding: 8px 10px 4px 0;
}

.desk-detail-void-count {
    font-size: 11px;
    color: rgb(180, 100, 255);
    -unity-font-style: bold;
    padding: 8px 10px 4px 0;
}

.desk-header__duplicate-warning {
    position: absolute;
    left: 50%;
    width: 440px;
    margin-left: -220px;
    padding: 4px 8px;
    color: rgb(255, 202, 130);
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.desk-header__duplicate-warning--hidden {
    display: none;
}

/* Star badge — top-right corner of filled slot card */
.desk-slot__star-btn {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.4);
    background-color: rgba(16, 20, 36, 0.85);
    color: rgb(80, 90, 130);
    font-size: 12px;
    -unity-text-align: middle-center;
    padding: 0;
    transition-duration: 0.1s;
}

.desk-slot__star-btn:hover {
    border-color: rgba(255, 210, 50, 0.7);
    background-color: rgba(50, 42, 8, 0.9);
    color: rgb(255, 215, 60);
}

.desk-slot__star-btn--active {
    border-color: rgba(255, 200, 40, 0.8);
    background-color: rgba(60, 50, 8, 0.9);
    color: rgb(255, 215, 60);
}

.desk-slot__star-btn--active:hover {
    background-color: rgba(90, 75, 12, 0.95);
    color: rgb(255, 235, 100);
}

.desk-slot__star-btn:disabled {
    opacity: 0.25;
}

/* Void badge — top-left corner of filled slot card */
.desk-slot__void-btn {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.4);
    background-color: rgba(16, 20, 36, 0.85);
    color: rgb(80, 90, 130);
    font-size: 10px;
    -unity-text-align: middle-center;
    padding: 0;
    transition-duration: 0.1s;
}

.desk-slot__void-btn:hover {
    border-color: rgba(180, 80, 255, 0.7);
    background-color: rgba(35, 10, 50, 0.9);
    color: rgb(200, 100, 255);
}

.desk-slot__void-btn--active {
    border-color: rgba(180, 80, 255, 0.8);
    background-color: rgba(45, 12, 60, 0.9);
    color: rgb(200, 100, 255);
}

.desk-slot__void-btn--active:hover {
    background-color: rgba(65, 18, 90, 0.95);
    color: rgb(220, 130, 255);
}

.desk-slot__void-btn:disabled {
    opacity: 0.25;
}

/* ============================================================
   Inventory list (right panel)
   ============================================================ */
.desk-inventory-search {
    margin: 0 10px 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.4);
    background-color: rgba(22, 26, 42, 1);
    color: rgb(200, 210, 255);
    font-size: 12px;
}

.desk-inventory-search > .unity-base-text-field__input {
    background-color: transparent;
    color: rgb(200, 210, 255);
    border-width: 0;
    padding: 6px 8px;
}

.desk-inventory-list {
    flex: 1;
    padding: 0 10px 10px 10px;
}

.desk-inv-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(22, 26, 40, 0.8);
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.2);
    padding: 8px 10px;
    margin-bottom: 5px;
    transition-duration: 0.1s;
    cursor: link;
}

.desk-inv-item:hover {
    background-color: rgba(40, 55, 100, 0.85);
    border-color: rgba(100, 140, 255, 0.45);
}

.desk-inv-item__icon {
    font-size: 20px;
    width: 28px;
    min-width: 28px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.desk-inv-item__info {
    flex: 1;
    flex-direction: column;
    overflow: hidden;
}

.desk-inv-item__name {
    font-size: 11px;
    color: rgb(200, 215, 255);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.desk-inv-item__meta {
    font-size: 9px;
    color: rgb(110, 125, 175);
    margin-top: 1px;
}

.desk-inv-item__qty {
    font-size: 10px;
    color: rgb(100, 175, 120);
    min-width: 28px;
    -unity-text-align: middle-right;
    margin-left: 6px;
}

/* ============================================================
   Card tile component — used in inventory list
   ============================================================ */
.desk-card {
    width: 96px;
    height: 132px;
    margin: 4px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(80, 100, 160, 0.35);
    background-color: rgba(16, 20, 36, 1);
    flex-direction: column;
    align-items: stretch;
    transition-duration: 0.12s;
    cursor: default;
    overflow: hidden;
}

.desk-card,
.desk-card * {
    position: relative;
}

.desk-card:hover {
    border-color: rgba(140, 170, 255, 0.7);
    background-color: rgba(28, 36, 64, 1);
}

.desk-card__actions {
    flex-direction: row;
    height: 16px;
    min-height: 16px;
    margin: 0 3px 3px 3px;
}

.desk-card__action-btn {
    flex: 1;
    height: 16px;
    font-size: 8px;
    padding: 0px 2px;
    margin: 0 1px;
    border-radius: 4px;
    border-width: 1px;
    -unity-text-align: middle-center;
    transition-duration: 0.1s;
    cursor: link;
}

.desk-card__view-btn {
    border-color: rgba(80, 130, 230, 0.5);
    background-color: rgba(30, 60, 130, 0.8);
    color: rgb(150, 195, 255);
}

.desk-card__view-btn:hover {
    background-color: rgba(50, 90, 180, 0.9);
    color: rgb(200, 225, 255);
}

.desk-card__add-btn {
    border-color: rgba(80, 190, 120, 0.55);
    background-color: rgba(25, 110, 60, 0.8);
    color: rgb(145, 240, 175);
}

.desk-card__add-btn:hover {
    background-color: rgba(35, 150, 80, 0.9);
    color: rgb(205, 255, 220);
}

/* Art area — top portion of the card */
.desk-card__art-area {
    height: 64px;
    min-height: 64px;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 22, 0.85);
}

.desk-card__art-icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
}

/* Info area — bottom portion */
.desk-card__info {
    flex: 1;
    flex-direction: column;
    align-items: center;
    padding: 0 4px 0 4px;
    background-color: rgba(12, 15, 28, 0.9);
    overflow: hidden;
}

.desk-card__name {
    height: 18px;
    min-height: 18px;
    font-size: 9px;
    color: rgb(210, 220, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    -unity-word-wrap: true;
    margin-bottom: 1px;
}

.desk-card__rarity {
    height: 9px;
    min-height: 9px;
    font-size: 8px;
    color: rgb(110, 125, 175);
    -unity-text-align: middle-center;
    margin-bottom: 0;
}

/* Rarity color overrides */
.desk-card__rarity--common   { color: rgb(150, 155, 165); }
.desk-card__rarity--uncommon { color: rgb(90, 190, 110); }
.desk-card__rarity--rare     { color: rgb(80, 145, 240); }
.desk-card__rarity--epic     { color: rgb(175, 90, 240); }
.desk-card__rarity--legendary { color: rgb(230, 170, 40); }

/* Rarity border overrides */
.desk-card--rarity-uncommon  { border-color: rgba(60,  180,  80, 0.45); }
.desk-card--rarity-rare      { border-color: rgba(60,  120, 220, 0.5);  }
.desk-card--rarity-epic      { border-color: rgba(140,  60, 220, 0.5);  }
.desk-card--rarity-legendary { border-color: rgba(220, 160,  30, 0.6);  }

.desk-card__qty {
    align-self: auto;
    top: 0;
    right: 0;
    font-size: 9px;
    color: rgb(10, 15, 30);
    background-color: rgb(100, 200, 120);
    border-radius: 6px;
    padding: 1px 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ============================================================
   Dim layer — shown between desk content and Card 3D review
   ============================================================ */
.desk-dim-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
}

.desk-dim-layer--hidden {
    display: none;
}

.desk-dim-close-btn {
    position: absolute;
    top: 16px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(200, 210, 255, 0.35);
    background-color: rgba(30, 36, 60, 0.85);
    color: rgb(220, 225, 255);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-duration: 0.1s;
}

.desk-dim-close-btn:hover {
    background-color: rgba(160, 40, 40, 0.85);
    border-color: rgba(255, 120, 120, 0.6);
    color: rgb(255, 200, 200);
}

/* ============================================================
   Fly animation overlay
   ============================================================ */
.desk-fly-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.desk-fly-ghost {
    position: absolute;
    font-size: 32px;
    width: 40px;
    height: 40px;
    -unity-text-align: middle-center;
}

/* ============================================================
   Card viewer overlay (3D-style card detail)
   ============================================================ */
.desk-card-viewer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.desk-card-viewer--hidden {
    display: none;
}

.desk-card-viewer__backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 6, 14, 0.88);
}

.desk-card-viewer__stage {
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.desk-card-viewer__card {
    width: 220px;
    min-height: 320px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(120, 160, 255, 0.55);
    background-color: rgba(14, 18, 38, 1);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    padding: 20px 16px;
    translate: 0 0px;
    transition-duration: 0.25s;
    transition-property: translate, scale;
    scale: 1 1;
}

.desk-card-viewer__card-icon {
    font-size: 72px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.desk-card-viewer__card-name {
    font-size: 16px;
    color: rgb(220, 230, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
    -unity-word-wrap: true;
    max-width: 190px;
}

.desk-card-viewer__card-rarity {
    font-size: 11px;
    color: rgb(180, 150, 80);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.desk-card-viewer__card-category {
    font-size: 10px;
    color: rgb(110, 130, 180);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.desk-card-viewer__card-qty {
    font-size: 11px;
    color: rgb(100, 130, 170);
    -unity-text-align: middle-center;
    padding: 4px 12px;
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.4);
    background-color: rgba(20, 26, 50, 0.7);
}

.desk-card-viewer__close-btn {
    margin-top: 20px;
    padding: 10px 32px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(80, 100, 160, 0.45);
    background-color: rgba(30, 38, 70, 0.8);
    color: rgb(160, 175, 230);
    font-size: 13px;
    transition-duration: 0.1s;
}

.desk-card-viewer__close-btn:hover {
    background-color: rgba(50, 65, 120, 0.9);
    color: rgb(210, 220, 255);
}
